{
  "name": "@voltjs/compiler",
  "version": "0.1.0",
  "description": "Volt template compiler \u2014 parses ':'-prefixed templates and emits fine-grained DOM code.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "keywords": [
    "compiler",
    "template",
    "volt"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
