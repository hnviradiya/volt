{
  "name": "@voltjs/core",
  "version": "0.1.0",
  "description": "Volt core \u2014 class components, lifecycle, and the fine-grained DOM runtime.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime.ts",
    "./jit": "./src/jit.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@voltjs/reactivity": "workspace:*",
    "@voltjs/compiler": "workspace:*"
  },
  "keywords": [
    "ui",
    "framework",
    "components",
    "volt"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./runtime": {
        "types": "./dist/runtime.d.ts",
        "import": "./dist/runtime.js"
      },
      "./jit": {
        "types": "./dist/jit.d.ts",
        "import": "./dist/jit.js"
      }
    }
  }
}
