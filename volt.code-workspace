{
  "folders": [
    { "name": "volt", "path": "." },
    { "name": "reactivity", "path": "packages/reactivity" },
    { "name": "compiler", "path": "packages/compiler" },
    { "name": "core", "path": "packages/core" },
    { "name": "vite-plugin", "path": "packages/vite-plugin" },
    { "name": "example", "path": "examples/counter" },
    { "name": "docs", "path": "docs" }
  ],
  "settings": {
    "typescript.tsdk": "node_modules/typescript/lib",
    "typescript.enablePromptUseWorkspaceTsdk": true,
    "typescript.preferences.importModuleSpecifierEnding": "js",
    "typescript.preferences.preferTypeOnlyAutoImports": true,
    "typescript.tsserver.experimental.enableProjectDiagnostics": true,

    "editor.formatOnSave": true,
    "editor.rulers": [90],
    "editor.tabSize": 2,
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,

    "files.exclude": {
      "**/dist": true,
      "**/node_modules": true,
      "**/*.tsbuildinfo": true,
      "**/.vitepress/cache": true
    },
    "search.exclude": {
      "**/dist": true,
      "**/pnpm-lock.yaml": true
    },

    "npm.packageManager": "pnpm",
    "vitest.enable": true,

    // Volt templates live in tagged template literals; this keeps the HTML
    // inside them highlighted and formatted.
    "html.format.wrapLineLength": 90,
    "emmet.includeLanguages": { "typescript": "html" }
  },
  "extensions": {
    "recommendations": [
      "vitest.explorer",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "test",
        "type": "shell",
        "command": "pnpm test",
        "group": { "kind": "test", "isDefault": true },
        "problemMatcher": []
      },
      {
        "label": "typecheck",
        "type": "shell",
        "command": "pnpm typecheck",
        "problemMatcher": ["$tsc"]
      },
      {
        "label": "build",
        "type": "shell",
        "command": "pnpm build",
        "group": { "kind": "build", "isDefault": true },
        "problemMatcher": []
      },
      {
        "label": "dev: example app",
        "type": "shell",
        "command": "pnpm dev",
        "isBackground": true,
        "problemMatcher": []
      },
      {
        "label": "dev: docs",
        "type": "shell",
        "command": "pnpm docs:dev",
        "isBackground": true,
        "problemMatcher": []
      }
    ]
  }
}
